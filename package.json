{
  "name": "marketplace-b2b",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.12"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "dotenv -e .env.local -- sh -c \"NODE_OPTIONS='--import ./instrument.server.mjs' vite dev --port 3000\"",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "start": "vite preview",
    "typecheck": "tsc --noEmit",
    "db:start": "node scripts/local-db.mjs start",
    "db:stop": "node scripts/local-db.mjs stop",
    "db:status": "node scripts/local-db.mjs status",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- tsx scripts/migrate.ts",
    "db:seed": "dotenv -e .env.local -- tsx scripts/seed.ts",
    "db:setup": "pnpm db:start && pnpm db:migrate && pnpm db:seed",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:integration": "LOCAL_DB_ROOT=.local/postgres-test pnpm db:start && tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@sentry/tanstackstart-react": "^10.67.0",
    "@t3-oss/env-core": "^0.13.10",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/match-sorter-utils": "9.1.2",
    "@tanstack/react-devtools": "0.10.12",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/react-start": "1.168.49",
    "@tanstack/react-table": "9.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.577.0",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.13.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/eslint-config": "0.4.0",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.20.0",
    "prettier": "^3.8.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  },
  "intent": {
    "skills": [
      "*"
    ]
  }
}
